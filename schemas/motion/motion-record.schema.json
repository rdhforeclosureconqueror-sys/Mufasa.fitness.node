{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://pocketpt.local/schemas/motion/motion-record.schema.json",
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "motionId",
          "exerciseId",
          "displayName",
          "version",
          "provenanceReference",
          "loopPolicy",
          "trimPolicy",
          "rootMotionPolicy",
          "reductionPolicy",
          "compressionPolicy",
          "fixtureIdsBySkeletonProfile",
          "status",
          "audience"
        ],
        "properties": {
          "motionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "exerciseId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "provenanceReference": {
            "type": "string",
            "minLength": 1
          },
          "loopPolicy": {
            "enum": [
              "loop",
              "once"
            ]
          },
          "trimPolicy": {
            "type": "string"
          },
          "rootMotionPolicy": {
            "type": "string"
          },
          "reductionPolicy": {
            "type": "string"
          },
          "compressionPolicy": {
            "type": "string"
          },
          "fixtureIdsBySkeletonProfile": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
            }
          },
          "status": {
            "enum": [
              "active",
              "development"
            ]
          },
          "audience": {
            "enum": [
              "product",
              "development"
            ]
          }
        }
      }
    }
  }
}
