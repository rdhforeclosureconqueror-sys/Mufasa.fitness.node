{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://pocketpt.local/schemas/motion/skeleton-profile.schema.json",
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skeletonProfileId",
          "rootJoint",
          "jointCount",
          "requiredAnimationTargets",
          "units",
          "upAxis",
          "forwardAxis",
          "compatibilityStatus",
          "status",
          "audience"
        ],
        "properties": {
          "skeletonProfileId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "rootJoint": {
            "type": "string",
            "minLength": 1
          },
          "jointCount": {
            "type": "integer",
            "minimum": 1
          },
          "requiredAnimationTargets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "units": {
            "enum": [
              "meters",
              "unknown"
            ]
          },
          "upAxis": {
            "enum": [
              "+Y",
              "unknown"
            ]
          },
          "forwardAxis": {
            "type": "string",
            "minLength": 1
          },
          "compatibilityStatus": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "development"
            ]
          },
          "audience": {
            "enum": [
              "product",
              "development"
            ]
          }
        }
      }
    }
  }
}
