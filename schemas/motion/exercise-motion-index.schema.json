{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://pocketpt.local/schemas/motion/exercise-motion-index.schema.json",
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exerciseId",
          "preferredMotionId",
          "avatarProfileId",
          "cameraPreset",
          "loop",
          "status",
          "audience"
        ],
        "properties": {
          "exerciseId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "preferredMotionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "avatarProfileId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "cameraPreset": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "loop": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "active",
              "development"
            ]
          },
          "audience": {
            "enum": [
              "product",
              "development"
            ]
          }
        }
      }
    }
  }
}
