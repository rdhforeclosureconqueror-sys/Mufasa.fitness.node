{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://pocketpt.local/schemas/motion/fixture-record.schema.json",
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixtureId",
          "motionId",
          "skeletonProfileId",
          "compatibleAvatarProfileIds",
          "assetUrl",
          "clipName",
          "expectedTrackCount",
          "expectedBoundTrackCount",
          "expectedUnboundTrackCount",
          "structuralExpectations",
          "provenanceReference",
          "sha256",
          "fileSizeBytes",
          "status",
          "audience",
          "developmentOnly"
        ],
        "properties": {
          "fixtureId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "motionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "skeletonProfileId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
          },
          "compatibleAvatarProfileIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*$"
            }
          },
          "assetUrl": {
            "type": "string",
            "pattern": "^/motion/assets/.+\\.glb$"
          },
          "clipName": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expectedTrackCount": {
            "type": "integer",
            "minimum": 1
          },
          "expectedBoundTrackCount": {
            "type": "integer",
            "minimum": 0
          },
          "expectedUnboundTrackCount": {
            "type": "integer",
            "minimum": 0
          },
          "structuralExpectations": {
            "type": "object"
          },
          "provenanceReference": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fileSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "active",
              "development"
            ]
          },
          "audience": {
            "enum": [
              "product",
              "development"
            ]
          },
          "developmentOnly": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
