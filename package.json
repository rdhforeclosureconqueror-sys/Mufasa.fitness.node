{
  "name": "mufasa-fitness-brain",
  "version": "1.1.1",
  "description": "Mufasa Node fitness brain (fitness domain, exercise DB + command bus)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "build:exercise-index": "node scripts/build-exercise-index.js",
    "prestart": "node scripts/ensure-exercise-index.js",
    "start": "node server.js",
    "lint": "node scripts/selfcheck.js",
    "test": "node --test",
    "pilot:nonsecurity-checks": "node scripts/pilot-nonsecurity-checks.js",
    "performance:audit": "node scripts/performance-audit.js",
    "ops:verify-audit": "node scripts/verify-admin-audit-chain.js",
    "ops:preflight": "node scripts/control-plane-preflight.js",
    "ops:migrate-gamification": "node scripts/migrate-gamification-operations.js",
    "ops:verify-gamification-staging": "node scripts/verify-gamification-staging.js",
    "ops:rehearse-gamification-rollback": "node scripts/rehearse-gamification-rollback.js",
    "ops:pilot-checks": "node scripts/run-pilot-control-plane-checks.js",
    "diagnostics:routes": "node scripts/diagnostics-routes.js",
    "repo:route-audit": "node scripts/repo-route-audit.js",
    "diagnostics:routes:local": "node scripts/diagnostics-routes-local.js",
    "pilot:readiness:local": "node scripts/pilot-readiness-local.js",
    "security:check": "node --test test/phase12a-security-remediation.test.js",
    "test:security": "node --test test/auth-hardening-phase13.test.js test/phase12a-security-remediation.test.js test/trainer-workspace.test.js",
    "validate:exercise-metadata": "node scripts/validate-exercise-metadata.js",
    "export:exercise-metadata-review": "node scripts/export-exercise-metadata-review.js",
    "generate:exercise-review-workspace": "node scripts/generate-exercise-review-workspace.js",
    "validate:fitness-bot-review": "node scripts/validate-fitness-bot-review.js",
    "generate:exercise-profiles": "node scripts/generate-exercise-profiles.js",
    "generate:exercise-runtime": "node scripts/generate-exercise-profiles.js",
    "validate:exercise-schemas": "node scripts/validate-exercise-generation.js",
    "validate:exercise-semantics": "node scripts/validate-exercise-semantics.js",
    "test:exercise-parity": "node --test test/exercise-runtime-parity.test.js",
    "verify:generated-artifacts": "node scripts/verify-generated-artifacts.js",
    "migrate:exercise-profiles:dry-run": "node scripts/migrate-exercise-profiles.js --dry-run",
    "audit:exercise-release": "node scripts/audit-exercise-release.js",
    "test:trails-live": "node scripts/trails-live-check.js",
    "ai-coach:launch-verify": "node scripts/verify-ai-coach-launch.js",
    "legacy:inventory": "node scripts/inventory-legacy-knowledge.js",
    "legacy:reconcile": "node scripts/reconcile-legacy-knowledge.js",
    "legacy:validate": "node scripts/validate-reconciliation-register.js",
    "legacy:report": "node scripts/report-reconciliation-coverage.js",
    "security:validate-routes": "node scripts/validate-route-authorization.js",
    "env:validate": "node scripts/validate-environment.js",
    "generate:exercise-sequence-review": "node scripts/generate-exercise-sequence-review.js",
    "motion:inventory-phase-e": "node scripts/motion/inventory-phase-e-assets.js",
    "motion:validate-phase-e": "node scripts/motion/validate-phase-e-glb.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "three": "^0.158.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  }
}
