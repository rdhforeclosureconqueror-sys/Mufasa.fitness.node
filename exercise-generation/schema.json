{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mufasa.exercise-source.v1",
  "title": "Human-maintained exercise source",
  "type": "object",
  "additionalProperties": false,
  "required": ["exerciseId", "displayName", "schemaVersion", "sourceVersion", "exerciseFamily", "movementPatterns", "equipment", "bodyPosition", "kineticChain", "laterality", "movementType", "phases", "cameraCandidates", "candidateMeasurements", "unsupportedAssessments", "trainerReviewRequirements", "overrides"],
  "properties": {
    "exerciseId": {"type":"string","pattern":"^[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "displayName": {"type":"string","minLength":1},
    "schemaVersion": {"const":1},
    "sourceVersion": {"type":"integer","minimum":1},
    "exerciseFamily": {"type":"string","minLength":1},
    "movementPatterns": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "equipment": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "bodyPosition": {"type":"string"},
    "kineticChain": {"enum":["open","closed","mixed"]},
    "laterality": {"enum":["bilateral","unilateral","alternating"]},
    "movementType": {"enum":["dynamic","isometric","mixed"]},
    "difficulty": {"type":"string"},
    "primaryJoints": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "secondaryJoints": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "primaryMuscles": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "secondaryMuscles": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "balanceRequirement": {"type":"string"},
    "supportSurface": {"type":"string"},
    "loadType": {"type":"string"},
    "phases": {"type":"object","additionalProperties":false,"required":["phaseOne","hold","phaseTwo"],"properties":{"phaseOne":{"type":"string"},"hold":{"type":"string"},"phaseTwo":{"type":"string"}}},
    "cameraCandidates": {"type":"array","uniqueItems":true,"items":{"enum":["front","side","either","not_supported"]}},
    "candidateMeasurements": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "unsupportedAssessments": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "translationRiskTerms": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "trainerReviewRequirements": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "overrides": {"type":"object"}
  }
}
