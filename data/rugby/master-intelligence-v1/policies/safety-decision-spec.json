        "ACR-142",
        "ACR-150",
        "ACR-152"
      ],
      "trigger": "worsening symptoms, pain, or failure to improve",
      "action": "review rather than increase corrective volume; pain routes to medical review",
      "tests": [
        [
          "no improvement",
          "review"
        ],
        [
          "pain",
          "block_and_refer"
        ]
      ],
      "priority": "safety_before_performance",
      "status": "proposed_review_required",
      "runtime_activation": false
    },
