  "policy": "Proposed engineering interpretation of recovered wording. Unknown safety inputs hold for review; this is a proposed implementation safeguard, not a course quotation. Test vectors are specifications, not executed tests.",
  "policies": [
    {
      "id": "screening-pain",
      "sources": [
        "ACR-128",
        "ACR-132",
        "ACR-133",
        "ACR-151"
      ],
      "trigger": "pain during screening or concerning clinical finding",
      "action": "block automated corrective programming; route to qualified medical review",
      "exceptions": "No automatic clearance when pain is absent.",
      "tests": [
        [
          "pain reported",
          "block_and_refer"
        ],
        [
          "pain unknown",
          "hold_for_review"
        ]
      ],
      "priority": "safety_before_performance",
      "status": "proposed_review_required",
      "runtime_activation": false
    },
    {
      "id": "screening-interpretation",
      "sources": [
        "ACR-127",
        "ACR-137",
        "ACR-139",
        "ACR-146",
        "ACR-149"
      ],
      "trigger": "screening result or ROM reference comparison",
      "action": "report contextual finding; prohibit standalone diagnosis or injury prediction",
      "tests": [
        [
          "below course reference",
          "contextual_flag_only"
        ]
      ],
      "priority": "safety_before_performance",
      "status": "proposed_review_required",
      "runtime_activation": false
    },
    {
