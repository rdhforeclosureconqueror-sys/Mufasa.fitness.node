{
  "schemaVersion": 2,
  "contractId": "stationary_lunge_left_reference_v2",
  "exerciseId": "stationary_lunge_left",
  "status": "development-coaching-contract",
  "purpose": "Define a complete left-forward stationary lunge with long entry stance, three vertical repetitions, owner-approved split-plant calibration, and return to standing.",
  "authorityBoundary": {
    "biomechanicalGroundTruth": false,
    "medicalDiagnosis": false,
    "movementScreenOnly": true,
    "notes": "Engineering reference for the shipped avatar. Device visual acceptance remains required."
  },
  "canonicalMotion": {
    "version": 2.3,
    "motionId": "lunge/stationary_left_movement_definition_v2_3_owner_split_knee"
  },
  "sequence": {
    "start": "neutral_standing",
    "entry": "left_foot_steps_forward_into_long_split_stance",
    "loadedRepetitions": 3,
    "loadedCycle": ["vertical_descent", "bottom", "vertical_ascent"],
    "exit": "left_foot_steps_back_to_neutral_standing",
    "finish": "same_neutral_standing_as_start"
  },
  "phaseOrder": ["stand_start","step_forward","split_plant","rep1_descent","rep1_bottom","rep1_top","rep2_descent","rep2_bottom","rep2_top","rep3_descent","rep3_bottom","rep3_top","step_back","stand_finish"],
  "setup": {
    "step": {"frontSide":"left","rearSide":"right","rule":"left_foot_steps_forward_far_enough_to_create_lunge_space","hardFail":true},
    "plant": {"rule":"establish_stable_long_split_stance_before_loading","hardFail":true},
    "contacts": {
      "frontFoot":{"contact":"left_front_foot","bone":"mixamorig:LeftFoot","hardFail":true},
      "rearFoot":{"contact":"right_rear_forefoot","bone":"mixamorig:RightToeBase","hardFail":true},
      "anchorEstablishmentPhase":"split_plant",
      "anchorReleasePhase":"step_back",
      "flightPermittedDuringLoadedRepetitions":false
    }
  },
  "numericalTargets": {
    "stepForwardLeftHipFlexionMinimumDegrees": 50,
    "splitPlantLeftHipFlexionMinimumDegrees": 35,
    "splitPlantRearHipExtensionMinimumDegrees": 30,
    "frontKneeInsideAngleDegrees":{"bottomTarget":90,"bottomEngineeringToleranceDegrees":10},
    "rearKneeInsideAngleDegrees":{"bottomTarget":90,"bottomEngineeringToleranceDegrees":15},
    "frontShinFromVerticalDegrees":{"bottomTarget":0,"bottomEngineeringToleranceDegrees":10},
    "pelvisBottomDrop":{"authoredTarget":0.14,"unit":"avatar_height","direction":"down"}
  },
  "ownerCalibration": {
    "phaseId": "split_plant",
    "target": "right_knee",
    "bone": "mixamorig:RightLeg",
    "axis": "x",
    "approvedDeltaDegrees": 5,
    "v22BasePitchDegrees": -6,
    "requiredPitchDegrees": -1,
    "scope": "split_plant_only",
    "firstFailingBoundary": "LUNGE_OWNER_CALIBRATION",
    "note": "Only split_plant was owner-approved. rep1_top, rep2_top, and rep3_top remain at the unreviewed v2.2 right-knee pitch of -6 degrees."
  },
  "hardConstraints": [
    "start_in_neutral_standing",
    "step_left_foot_forward_before_loading",
    "entry_stride_meets_geometry_gate",
    "establish_split_plant_before_loaded_descent",
    "owner_split_plant_right_knee_pitch_is_minus_1_degree",
    "front_whole_foot_contact_during_loaded_repetitions",
    "right_rear_toe_forefoot_contact_during_loaded_repetitions",
    "pelvis_descent_is_vertical_dominant",
    "front_knee_approaches_90_degrees_at_bottom",
    "rear_knee_descends_toward_floor",
    "three_loaded_repetitions",
    "step_back_only_after_rep3_top",
    "finish_in_same_neutral_standing_pose"
  ],
  "trajectory": {
    "loadedDescent":{"target":"pelvis","dominantDirection":"vertical_down","maxHorizontalToVerticalTravelRatio":0.25,"rearKneeDirection":"down_toward_floor"},
    "loadedAscent":{"target":"pelvis","dominantDirection":"vertical_up","maxHorizontalToVerticalTravelRatio":0.25,"returnTarget":"same_split_top"}
  },
  "compensationSignals": [
    {"id":"entry_step_too_short","view":"side","meaning":"split stance is too short to support the declared lunge geometry"},
    {"id":"front_knee_excessive_forward_travel","view":"side","meaning":"front shin is no longer near vertical"},
    {"id":"rear_knee_not_descending","view":"side","meaning":"rear knee does not move toward the floor"},
    {"id":"feet_restep_between_reps","view":"side","meaning":"the planted split stance was not preserved"}
  ],
  "sourceEvidenceBoundary": "Reference sources supply primitive mechanics only. The canonical v2.3 definition and the owner-approved split_plant calibration are authoritative for this development reference."
